{
    "name": "vitest-monocart-coverage",
    "version": "5.0.0",
    "description": "",
    "type": "module",
    "main": "./lib/index.js",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "node": "./lib/index.js",
            "default": "./lib/browser.js"
        },
        "./browser": {
            "types": "./lib/index.d.ts",
            "import": "./lib/browser.js",
            "default": "./lib/browser.js"
        },
        "./package.json": "./package.json"
    },
    "types": "./lib/index.d.ts",
    "scripts": {
        "link": "sf link ./ -f",
        "test": "vitest run -c vitest.config.js",
        "test:browser": "vitest run -c vitest.browser.config.js",
        "patch": "npm run test && sf publish patch -r"
    },
    "files": [
        "lib"
    ],
    "license": "MIT",
    "engines": {
        "node": ">=22.15.0"
    },
    "dependencies": {
        "@vitest/coverage-v8": "^5.0.5",
        "monocart-coverage-reports": "^3.0.0"
    },
    "devDependencies": {
        "@vitest/browser": "^5.0.5",
        "@vitest/browser-playwright": "^5.0.5",
        "eslint": "^10.13.0",
        "eslint-config-plus": "^2.1.0",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    }
}
